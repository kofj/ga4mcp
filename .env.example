# OAuth client used to sign in to Google Analytics.
# Copy to ~/.config/ga4mcp/.env and fill in the values from the Google Cloud
# console (APIs & Services > Credentials > OAuth client ID, type "Desktop app").
GA4MCP_CLIENT_ID=
GA4MCP_CLIENT_SECRET=

# Bearer token clients must send to /mcp, for example:
#   openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional. Only needed when the browser reaches the callback at a URL other
# than http://127.0.0.1:<port>/callback; register the same URL on the client.
# GA4MCP_REDIRECT_URL=https://example.com/callback

# Optional. Host port the container is published on (default 8080).
# GA4MCP_PORT=8080
